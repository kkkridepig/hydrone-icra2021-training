<?xml version="1.0"?>
<robot name="hydrone_interface_pilot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find hydrone_aerial_underwater_description)/robots/hydrone_aerial_underwater_aerial.xacro"/>
  <!-- No additional mass or collision. Camera looks forward/downward. -->
  <gazebo reference="$(arg namespace)/base_link">
    <sensor name="interface_rgb" type="camera">
      <pose>0.15 0 -0.04 0 0.30 0</pose>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.35</horizontal_fov>
        <image><width>96</width><height>96</height><format>R8G8B8</format></image>
        <clip><near>0.06</near><far>25</far></clip>
      </camera>
      <plugin name="interface_rgb_ros" filename="libgazebo_ros_camera.so">
        <robotNamespace>/$(arg namespace)</robotNamespace>
        <cameraName>interface_camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>$(arg namespace)/base_link</frameName>
        <updateRate>0.0</updateRate>
      </plugin>
    </sensor>
  </gazebo>
</robot>
